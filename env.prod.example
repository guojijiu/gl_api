# 生产环境配置示例
# 请复制此文件为 .env.prod 并修改相应的值

# 数据库配置
MYSQL_ROOT_PASSWORD=your_strong_root_password_here
DB_PASSWORD=your_strong_db_password_here

# Redis配置
REDIS_PASSWORD=your_strong_redis_password_here

# JWT配置
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_for_production

# AI 网关配置
CLOUD_PLATFORM_BASE_URL=https://your-cloud-platform.example.com
AI_GATEWAY_LLM_API_KEY=your_llm_api_key
AI_GATEWAY_LLM_MODEL=qwen-plus

# 公共 MongoDB 配置
# 说明：Laravel 侧可使用 mongodb_cloud_platform_v2 连接名；
# 这里的 MONGODB_DATABASE 填实际数据库名。
MONGODB_HOST=121.43.37.234
MONGODB_PORT=27117
MONGODB_DATABASE=cloud_platform
MONGODB_USERNAME=root
MONGODB_PASSWORD=your_mongodb_password
MONGODB_AUTH_SOURCE=admin
MONGODB_TIMEOUT_SEC=5

# ai_robot 会话上下文配置
AI_ROBOT_CONVERSATION_STORE_DRIVER=mongodb
AI_ROBOT_CONVERSATION_MONGO_COLLECTION=ai_robot_conversations
AI_ROBOT_CONVERSATION_TTL_HOURS=720
AI_ROBOT_CONVERSATION_AUTO_FILL_MAX_AGE_MINUTES=10
AI_ROBOT_CONVERSATION_AUTO_FILL_MAX_TURNS=3
AI_ROBOT_CONVERSATION_SUMMARY_MAX_TURNS=5

# Grafana配置
GRAFANA_PASSWORD=your_grafana_admin_password_here

# 服务器配置
SERVER_MODE=production
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=file

# 安全配置
SECURITY_ENABLED=true
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOGIN_LOCKOUT_DURATION=15m

# 性能监控配置
PERFORMANCE_MONITORING_ENABLED=true
PERFORMANCE_MONITORING_INTERVAL=30s

# 威胁防护配置
THREAT_PROTECTION_ENABLED=true
THREAT_INTELLIGENCE=true
THREAT_TI_UPDATE_INTERVAL=24h

# 邮件配置（如果需要）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@example.com

# 文件存储配置
STORAGE_PATH=/app/storage
MAX_FILE_SIZE=10485760  # 10MB

# 缓存配置
CACHE_ENABLED=true
CACHE_TTL=3600  # 1小时

# 限流配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # 秒
